# Bu dosya yalnızca gerekli ortam değişkenlerinin isimlerini/örnek biçimini gösterir.
# Gerçek anahtar, şifre veya secret DEĞERİ içermez. Gerçek değerler yalnızca
# yerel .env.local veya deploy ortamının secret yönetiminde tutulur ve repoya asla yazılmaz.

# Uygulama
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Veritabanı — prisma.config.ts ve src/server/db/prisma.ts tarafından kullanılır (Faz 2)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ossa"

# Entegrasyon testleri için AYRI, dev/production'dan izole veritabanı (bkz.
# tests/db.ts, docs/TEST_STRATEGY.md). Tanımsızsa destructive entegrasyon
# testleri sessizce ATLANIR — dev DB'ye asla otomatik kayıt yazılmaz.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ossa_test"

# Authentication — src/server/auth/auth.ts (Better Auth) tarafından kullanılır (Faz 3)
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""

# iyzico (Faz 8'de kullanılmaya başlanacak)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Dosya depolama — StorageProvider (Faz 4'te kullanılmaya başlanacak)
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""

# Transactional e-posta (bkz. src/server/providers/email-provider.ts):
#   EMAIL_PROVIDER="console" → yerel/dev, gerçek kimlik bilgisi gerektirmez,
#     e-posta içeriğini konsola basar.
#   EMAIL_PROVIDER="resend"  → production, gerçek gönderim (RESEND_API_KEY +
#     EMAIL_FROM ZORUNLU — eksikse sessizce console'a DÜŞMEZ, e-posta hiç
#     gönderilmez, sipariş akışı yine de ETKİLENMEZ).
# Boş/tanımsız/bilinmeyen değer → e-posta gönderimi devre dışı (sipariş akışı ETKİLENMEZ).
EMAIL_PROVIDER=""
EMAIL_FROM=""
RESEND_API_KEY=""
