datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ==================== Enums ====================

enum RoleKey {
  CUSTOMER
  STAFF
  ADMIN
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/**
 * `nutritionSource*` alanlarının hangi tür değeri temsil ettiği — bkz. `docs/PRODUCT_INFORMATION_RESEARCH_REPORT.md`.
 */
enum NutritionReferenceType {
  /**
   * Resmi/güvenilir bir kaynağın (ör. USDA FoodData Central) genel ortalama değeri — OSSA'nın kendi analizi DEĞİL.
   */
  REFERENCE_AVERAGE
  /**
   * OSSA'nın kendi laboratuvar analizi — şu an hiçbir üründe kullanılmıyor, ileride admin girebilsin diye tanımlı.
   */
  OSSA_LAB_ANALYSIS
}

/**
 * Bir ürünün besin/içindekiler verisine ne kadar güvenilebileceği — bkz. araştırma raporu §9.
 */
enum NutritionConfidence {
  HIGH
  MEDIUM
  LOW
  RECIPE_REQUIRED
}

enum InventoryMovementType {
  PURCHASE_IN
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum StockReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  PAYMENT_FAILED
  CANCELLATION_REQUESTED
  CANCELLED
  EXPIRED
  RETURN_REQUESTED
  RETURNED
  RETURN_REJECTED
}

enum InvoiceType {
  INDIVIDUAL
  CORPORATE
}

/**
 * Kargo ücretinin bilinme durumu — bilinmeyen ücret asla 0 (ücretsiz) ile karıştırılmaz.
 */
enum ShippingPriceStatus {
  PENDING
  FIXED
  FREE
}

/**
 * `grandTotal`'ın kesin tahsilat tutarı mı yoksa geçici mi olduğunu belirtir.
 */
enum OrderTotalStatus {
  PENDING
  FINAL
}

enum OrderEmailType {
  ADMIN_NEW_ORDER
  ORDER_RECEIVED
  STATUS_CONFIRMED
  STATUS_PROCESSING
  STATUS_SHIPPED
  STATUS_DELIVERED
  STATUS_CANCELLED
}

enum EmailSendStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  CALLBACK_RECEIVED
  VERIFIED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CampaignType {
  AUTOMATIC_DISCOUNT
  CATEGORY_DISCOUNT
  MULTI_BUY
  BUY_X_GET_Y
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerType {
  HERO
  FULL_WIDTH
}

enum ContactRequestType {
  GENERAL_INFO
  HENNA_SNACKS
  WEDDING_SNACKS
  ENGAGEMENT_INVITATION
  CORPORATE_BULK_ORDER
  OTHER
}

enum ContactRequestStatus {
  NEW
  REVIEWED
  CLOSED
}

enum MarketingCampaignType {
  DAILY
  WEEKLY
  MONTHLY
}

// ==================== Kimlik ve Erişim ====================

model Role {
  id        String   @id @default(cuid())
  key       RoleKey  @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id              String    @id @default(cuid())
  roleId          String
  email           String    @unique
  passwordHash    String?
  firstName       String
  lastName        String
  phone           String?
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Better Auth (bkz. src/server/auth/auth.ts) — ad/e-posta doğrulama/avatar alanları
  name          String?
  emailVerified Boolean @default(false)
  image         String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  orders             Order[]
  carts              Cart[]
  reviews            Review[]
  moderatedReviews   Review[]            @relation("ReviewModerator")
  blogPosts          BlogPost[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  couponUsages       CouponUsage[]
  favorites          Favorite[]

  @@index([roleId])
  @@index([isActive])
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Better Auth (bkz. src/server/auth/auth.ts) — credential provider parola hash'i ve
  // OAuth alanları için ek sütunlar; `provider`/`providerAccountId`/`expiresAt` mevcut
  // sütunlar `fields` eşlemesiyle yeniden kullanılıyor, burada yeniden adlandırılmadı.
  password              String?
  idToken               String?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Better Auth (bkz. src/server/auth/auth.ts) — oturum meta verisi
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Better Auth (bkz. src/server/auth/auth.ts) — e-posta doğrulama/parola sıfırlama token'ları
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Address {
  id                 String      @id @default(cuid())
  userId             String
  type               AddressType
  title              String
  firstName          String
  lastName           String
  phone              String
  city               String
  district           String
  neighborhood       String?
  postalCode         String?
  addressLine        String
  invoiceCompanyName String?
  taxOffice          String?
  taxNumber          String?
  isDefault          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== Katalog ====================

model Category {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  imageAlt    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  productCategories ProductCategory[]

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  shortDescription  String?
  description       String?
  ingredients       String?
  storageConditions String?
  /**
   * Ürüne özgü teslimat bilgisi override'ı — `null` iken PDP TÜM ürünlerde
   * ortak olan `getDeliveryInformationText()` (tek kargo iş kuralı kaynağı)
   * metnini göstermeye devam eder; yalnızca gerçekten ürüne özgü bir istisna
   * varsa admin panelinden doldurulur. Mevcut ürünlerin hiçbirinde dolu
   * DEĞİLDİR — mevcut paylaşılan davranış bozulmaz.
   */
  deliveryInfo      String?
  shelfLifeDays     Int?

  /**
   * Yalnızca ürünün kendisi doğrudan/kesin bir alerjen olduğunda dolu (ör. "Sert kabuklu yemiş (badem) içerir.") — çapraz bulaşma iddiası ASLA otomatik üretilmez.
   */
  allergenInfo    String?
  /**
   * Gerçekten doğrulanmış tedarik/menşe bilgisi — ürün adından (ör. "Antep Fıstığı") çıkarılmaz, boş kalması normaldir.
   */
  originInfo      String?
  usageSuggestion String?

  /**
   * 100 g için ortalama besin değerleri — kaynağı olmayan bir değer asla girilmez, bkz. `nutritionSource*`.
   */
  nutritionEnergyKcal   Decimal? @db.Decimal(7, 2)
  nutritionEnergyKj     Decimal? @db.Decimal(7, 2)
  nutritionFat          Decimal? @db.Decimal(6, 2)
  nutritionSaturatedFat Decimal? @db.Decimal(6, 2)
  nutritionCarbohydrate Decimal? @db.Decimal(6, 2)
  nutritionSugars       Decimal? @db.Decimal(6, 2)
  nutritionFiber        Decimal? @db.Decimal(6, 2)
  nutritionProtein      Decimal? @db.Decimal(6, 2)
  nutritionSalt         Decimal? @db.Decimal(6, 3)

  /**
   * Yukarıdaki `nutrition*` alanlarının izlenebilirliği — bir `nutritionEnergyKcal` vb. dolduğunda bu alanların da dolu olması beklenir (uygulama katmanında zorunlu kılınır, DB kısıtı değil).
   */
  nutritionSourceName    String?
  nutritionSourceUrl     String?
  nutritionSourceProduct String?
  nutritionReferenceType NutritionReferenceType?
  nutritionConfidence    NutritionConfidence?

  isFeatured       Boolean       @default(false)
  isRecommended    Boolean       @default(false)
  newBadgeOverride Boolean?
  sortOrder        Int           @default(0)
  status           ProductStatus @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants                ProductVariant[]
  images                  ProductImage[]
  productCategories       ProductCategory[]
  reviews                 Review[]
  orderItems              OrderItem[]
  blogPosts               BlogPostProduct[]
  favorites               Favorite[]
  featuredPicks           FeaturedProductPick[]
  homepageSelections      HomepageSelectionProduct[]
  bundleOffersAsPrimary   BundleOffer[]              @relation("BundleOfferPrimaryProduct")
  bundleOffersAsCompanion BundleOffer[]              @relation("BundleOfferCompanionProduct")

  @@index([status])
  @@index([isFeatured])
  @@index([isRecommended])
  @@index([sortOrder])
}

/**
 * Kullanıcıya bağlı favori/istek listesi — admin-küratörlü "Ayın Favorileri" (bkz. `FeaturedProductPick`) ile karıştırılmaz.
 */
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

/**
 * OSSA tarafından yönetilen editoryal "Ayın Favorileri" vitrini — kullanıcı favorilerinden (`Favorite`) tamamen bağımsızdır.
 */


model FeaturedProductPick {
  id            String    @id @default(cuid())
  productId     String
  sortOrder     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
}



/**
 * "Birlikte Daha Güzel" çapraz satış kampanyası — KOŞULLU bir fiyat (ana
 * varyant sepette olmadan asla uygulanmaz), bu yüzden `ProductVariant.discountPrice`
 * ile karıştırılmaz, tamamen ayrı bir modeldir. Varyant seviyesinde (ürün değil)
 * — fiyat gramaja göre değiştiğinden yanlış varyanta özel fiyat uygulanmasını
 * yapısal olarak imkânsız kılar.
 */
model BundleOffer {
  id                 String    @id @default(cuid())
  primaryProductId   String
  primaryVariantId   String
  companionProductId String
  companionVariantId String
  companionPrice     Decimal   @db.Decimal(12, 2)
  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  primaryProduct   Product        @relation("BundleOfferPrimaryProduct", fields: [primaryProductId], references: [id], onDelete: Cascade)
  primaryVariant   ProductVariant @relation("BundleOfferPrimaryVariant", fields: [primaryVariantId], references: [id], onDelete: Cascade)
  companionProduct Product        @relation("BundleOfferCompanionProduct", fields: [companionProductId], references: [id], onDelete: Cascade)
  companionVariant ProductVariant @relation("BundleOfferCompanionVariant", fields: [companionVariantId], references: [id], onDelete: Cascade)

  @@index([primaryVariantId, isActive])
  @@index([companionVariantId, isActive])
}

/**
 * Yönetilebilir, zamanlanmış pazarlama kampanyası — homepage/popup gösterimini
 * yöneten METADATA katmanıdır, bir fiyat motoru DEĞİLDİR. Fiyat her zaman
 * `ProductVariant.price`/`discountPrice` + `resolveVariantPricing()`'ten gelir
 * (bkz. `src/lib/product-pricing.ts`); bu model asla fiyat TUTMAZ. `type`
 * (DAILY/WEEKLY/MONTHLY) yalnızca admin formunda varsayılan bitiş tarihi
 * önerisi için kullanılır — kampanyanın gerçek aktifliği tamamen `isActive` +
 * `startsAt`/`endsAt` üzerinden hesaplanır (bkz. `src/lib/campaign-status.ts`).
 * Not: Şemada zaten var olan `Campaign`/`CampaignType` modeliyle KARIŞTIRILMAZ
 * — o, gelecekteki farklı bir özelliğe (otomatik indirim/kupon kural motoru,
 * bkz. `docs/OPEN_QUESTIONS.md` #28) ayrılmış, bu görevde kullanılmadı.
 */
model MarketingCampaign {
  id             String                @id @default(cuid())
  name           String
  type           MarketingCampaignType
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean               @default(true)
  showOnHomepage Boolean               @default(true)
  showPopup      Boolean               @default(false)
  headline       String?
  description    String?
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  products MarketingCampaignProduct[]

  @@index([isActive, startsAt, endsAt])
}

/**
 * Bir kampanyaya dahil edilen varyantlar — `BundleOffer` ile aynı gerekçeyle
 * ÜRÜN değil VARYANT seviyesinde (fiyat gramaja göre değiştiğinden).
 */

model MarketingCampaignProduct {
  campaignId    String
  variantId     String
  sortOrder     Int      @default(0)
  campaignPrice Decimal? @db.Decimal(12, 2)

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([campaignId, variantId])
  @@index([variantId])
}


model ProductVariant {
  id               String    @id @default(cuid())
  productId        String
  sku              String    @unique
  name             String
  weightGram       Int?
  price            Decimal   @db.Decimal(12, 2)
  discountPrice    Decimal?  @db.Decimal(12, 2)
  discountStartsAt DateTime?
  discountEndsAt   DateTime?
  isDiscountActive Boolean   @default(false)
  barcode          String?   @unique
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images                    ProductImage[]
  inventory                 Inventory?
  inventoryMovements        InventoryMovement[]
  stockReservations         StockReservation[]
  cartItems                 CartItem[]
  orderItems                OrderItem[]
  bundleOffersAsPrimary     BundleOffer[]              @relation("BundleOfferPrimaryVariant")
  bundleOffersAsCompanion   BundleOffer[]              @relation("BundleOfferCompanionVariant")
  marketingCampaignProducts MarketingCampaignProduct[]
  

  @@index([productId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/**
 * Bir ürünün TEK ana kategorisi — `@@unique([productId])` bunu DB seviyesinde
 * zorunlu kılar (bir üründe asla 2. bir satır oluşamaz). Alt grup yapısı
 * BURADA değil `@/lib/mega-menu-content.ts`'te yaşar — bu iki katman
 * KARIŞTIRILMAZ (ana kategori = bu tablo, ürün grubu = mega menü verisi).
 */
model ProductCategory {
  productId  String @unique
  categoryId String
  sortOrder  Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

// ==================== Stok ====================

model Inventory {
  id                String   @id @default(cuid())
  variantId         String   @unique
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int      @default(0)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id            String                @id @default(cuid())
  variantId     String
  orderId       String?
  actorId       String?
  type          InventoryMovementType
  quantityDelta Int
  reason        String?
  metadata      Json?
  createdAt     DateTime              @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model StockReservation {
  id         String                 @id @default(cuid())
  variantId  String
  orderId    String
  quantity   Int
  status     StockReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
}

// ==================== Sepet ====================

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  guestToken String?    @unique
  status     CartStatus @default(ACTIVE)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  variantId          String
  quantity           Int
  priceSnapshotAtAdd Decimal? @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ==================== Sipariş ====================

model Order {
  id                      String              @id @default(cuid())
  orderNumber             String              @unique
  userId                  String?
  couponId                String?
  email                   String
  phone                   String
  status                  OrderStatus         @default(PENDING)
  invoiceType             InvoiceType
  /**
   * Yalnızca `invoiceType=CORPORATE` iken dolu — sipariş-anı snapshot'ı, `Address.invoiceCompanyName` vb. alanlardan bağımsız.
   */
  invoiceCompanyName      String?
  invoiceTaxOffice        String?
  invoiceTaxNumber        String?
  subtotal                Decimal             @db.Decimal(12, 2)
  discountTotal           Decimal             @db.Decimal(12, 2)
  /**
   * Kargo ücreti bilinmiyorsa `null` — asla 0 ile temsil edilmez (bkz. `shippingPriceStatus`).
   */
  shippingTotal           Decimal?            @db.Decimal(12, 2)
  shippingPriceStatus     ShippingPriceStatus @default(PENDING)
  taxTotal                Decimal             @db.Decimal(12, 2)
  /**
   * `totalStatus=PENDING` iken kesin tahsilat tutarı DEĞİLDİR — yalnızca ara toplamı taşır; UI bunu göstermeden önce her zaman `totalStatus` kontrol eder.
   */
  grandTotal              Decimal             @db.Decimal(12, 2)
  totalStatus             OrderTotalStatus    @default(PENDING)
  currency                String              @default("TRY")
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json
  couponCodeSnapshot      String?
  customerNote            String?
  /**
   * Aynı checkout gönderiminin client tarafından üretilen tekrar-gönderim anahtarı — fiyat/güvenlik kararı için KULLANILMAZ.
   */
  idempotencyKey          String              @unique
  /**
   * Sunucuda doğrulanmış veriden (kullanıcı/e-posta + kalemler + adres + fatura tipi) SHA-256 — aynı anahtarın farklı içerikle yeniden kullanımını tespit eder.
   */
  requestFingerprint      String
  /**
   * Misafir + girişli müşterinin sipariş sonucu sayfasına erişimi için opak token — yalnızca sipariş numarasını bilmek erişim sağlamaz.
   */
  resultAccessToken       String              @unique
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  payments           Payment[]
  paymentAttempts    PaymentAttempt[]
  refunds            Refund[]
  shipments          Shipment[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  couponUsages       CouponUsage[]
  emailLogs          OrderEmailLog[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/**
 * Sipariş/durum bildirim e-postalarının gönderim kaydı — admin panelinde
 * gönderim durumu/son gönderim zamanı göstermek ve yeniden-gönderim hız
 * sınırlamasını (`RESEND_COOLDOWN_MS`, bkz. `order-email-service.ts`)
 * uygulamak için TEK kaynak. Her gönderim denemesi (başarılı/başarısız) ayrı
 * bir satır — üzerine yazma YOKTUR, geçmiş korunur.
 */
model OrderEmailLog {
  id           String          @id @default(cuid())
  orderId      String
  type         OrderEmailType
  status       EmailSendStatus
  recipient    String
  errorMessage String?
  createdAt    DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type, createdAt])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String?
  variantId        String?
  productName      String
  variantName      String
  sku              String
  quantity         Int
  /**
   * Sipariş anındaki normal/liste fiyatı — indirim geçmişte değişse/kaldırılsa bile sabit kalır.
   */
  regularUnitPrice Decimal  @db.Decimal(12, 2)
  /**
   * Sipariş anında müşterinin ödediği birim fiyat (indirim uygulanmışsa indirimli fiyat).
   */
  unitPrice        Decimal  @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review  Review?
}

// ==================== Ödeme ====================

model Payment {
  id                   String        @id @default(cuid())
  orderId              String
  provider             String
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("TRY")
  providerPaymentId    String?
  requiresManualReview Boolean       @default(false)
  conversationId       String        @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  paymentAttempts PaymentAttempt[]
  refunds         Refund[]

  @@index([orderId])
  @@index([status])
}

model PaymentAttempt {
  id              String               @id @default(cuid())
  orderId         String
  paymentId       String?
  attemptNumber   Int
  status          PaymentAttemptStatus @default(INITIATED)
  providerToken   String?
  conversationId  String               @unique
  requestedAmount Decimal              @db.Decimal(12, 2)
  failureCode     String?
  failureReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([orderId, attemptNumber])
  @@index([orderId])
  @@index([status])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  orderId          String
  providerRefundId String?
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  completedAt      DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

// ==================== Kargo ====================

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PREPARING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([trackingNumber])
}

// ==================== Kupon ve Kampanya ====================

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  type              CouponType
  value             Decimal    @db.Decimal(12, 2)
  minSubtotal       Decimal?   @db.Decimal(12, 2)
  maxDiscountCap    Decimal?   @db.Decimal(12, 2)
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  orders       Order[]
  couponUsages CouponUsage[]

  @@index([isActive, startsAt, endsAt])
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  orderId  String
  userId   String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
}

model Campaign {
  id            String       @id @default(cuid())
  name          String
  type          CampaignType
  value         Decimal?     @db.Decimal(12, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  priority      Int          @default(0)
  configuration Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ==================== İçerik ve Yönetim ====================

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String?
  orderItemId      String?      @unique
  rating           Int
  title            String?
  content          String?
  displayName      String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  moderatedAt      DateTime?
  moderatedById    String?
  rejectionReason  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderatedBy User?      @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status])
}

model BlogPost {
  id              String         @id @default(cuid())
  authorId        String
  title           String
  slug            String         @unique
  excerpt         String?
  content         String
  coverImageUrl   String?
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  author   User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  products BlogPostProduct[]

  @@index([status, publishedAt])
}

/**
 * Blog yazısı içinde bahsedilen ürünler — "Bu yazıda geçen ürünler" bölümü.
 */
model BlogPostProduct {
  blogPostId String
  productId  String
  sortOrder  Int    @default(0)

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([blogPostId, productId])
}

model Banner {
  id                   String     @id @default(cuid())
  type                 BannerType
  title                String
  subtitle             String?
  imageUrl             String
  imageAlt             String?
  primaryButtonLabel   String
  primaryButtonHref    String
  secondaryButtonLabel String?
  secondaryButtonHref  String?
  isActive             Boolean    @default(true)
  sortOrder            Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([type, isActive, sortOrder])
}

model EventCard {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  imageAlt    String?
  buttonLabel String
  buttonHref  String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/**
 * Ana sayfadaki "OSSA'dan Seçtiklerimiz" editoryal merchandising bölümünün
 * içeriği — tek bölüm olduğundan pratikte tek satır tutulur (hard DB
 * constraint yok, `Banner`'ın FULL_WIDTH tipi gibi "convention ile
 * singleton"; admin action'ı var olan satırı günceller). Fiyat burada
 * YOK — seçili ürünlerin fiyatı her zaman `ProductVariant`'tan gelir.
 */
model HomepageSelection {
  id          String   @id @default(cuid())
  isActive    Boolean  @default(false)
  eyebrow     String?
  title       String
  description String?
  ctaLabel    String
  ctaHref     String
  imageUrl    String?
  imageAlt    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products HomepageSelectionProduct[]
}

model HomepageSelectionProduct {
  id                  String @id @default(cuid())
  homepageSelectionId String
  productId           String
  sortOrder           Int    @default(0)

  homepageSelection HomepageSelection @relation(fields: [homepageSelectionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([homepageSelectionId, productId])
  @@index([homepageSelectionId, sortOrder])
}

enum InstagramMediaKind {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
}

/**
 * Ana sayfadaki küratörlü Instagram vitrini — hiçbir medya OSSA sunucusuna
 * yüklenmez/saklanmaz. Admin yalnızca `postUrl` (permalink) girer; gerçek
 * medya bilgisi resmi Instagram Graph API'den ("Instagram API with Instagram
 * Login") çözülüp aşağıdaki alanlara CACHE edilir (bkz. `instagram-graph-api.ts`,
 * `resolveInstagramMedia`). `postUrl` her zaman asıl referanstır; cache
 * alanları senkronizasyon başarısızsa `null` kalabilir — bu durumda storefront
 * bu gönderiyi hiç göstermez (bkz. `listActiveInstagramPosts`, "cache yoksa
 * render etme" kuralı), kırık/boş kart YOK.
 */
model InstagramPost {
  id               String              @id @default(cuid())
  postUrl          String
  caption          String?
  isActive         Boolean             @default(true)
  sortOrder        Int                 @default(0)
  instagramMediaId String?
  mediaType        InstagramMediaKind?
  mediaUrl         String?
  thumbnailUrl     String?
  captionCached    String?
  publishedAt      DateTime?
  lastSyncedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([isActive, sortOrder])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * /iletisim sayfasındaki genel iletişim ve toplu sipariş formundan gelen talepler.
 */
model ContactRequest {
  id                  String               @id @default(cuid())
  name                String
  phone               String?
  email               String?
  requestType         ContactRequestType
  eventDate           DateTime?
  estimatedGuestCount Int?
  message             String
  status              ContactRequestStatus @default(NEW)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/**
 * Production-safe (multi-instance/serverless) rate limiting — sabit pencere
 * sayacı. `DATABASE_URL` zaten uygulamanın çalışması için zorunlu olduğundan
 * bu tablo, yeni bir dış bağımlılık (Redis vb.) GEREKTİRMEDEN tüm instance'lar
 * arasında paylaşılan tek bir sayaç kaynağı sağlar (bkz. `rate-limit-provider.ts`).
 * `bucketKey`, hangi politikanın hangi kimlik için sayıldığını (ör.
 * `login:ip:1.2.3.0`, `login:email:<hash>`) taşır — ham PII asla saklanmaz,
 * gerekiyorsa HMAC-SHA256 ile hash'lenir.
 */
model RateLimitHit {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}

/**
 * Ana sayfa bölümlerinin admin-yönetilebilir sırası + görünürlüğü — TEK
 * kaynak olarak yalnızca `key`/`sortOrder`/`isActive` tutar; her bölümün
 * kendi içeriği (başlık/görsel/ürün seçimi) zaten kendi mevcut modelinde
 * yaşamaya devam eder (ör. `HomepageSelection`, `Banner`, `EventCard`) —
 * burada DUPLICATE edilmez. `key` stabil, koddan (bkz. `homepage-sections.ts`)
 * türetilir; DB'de bilinmeyen bir `key` varsa storefront onu sessizce yok
 * sayar (uydurma bölüm oluşturmaz).
 */
model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([sortOrder])
}
